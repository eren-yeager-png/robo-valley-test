# Copy to .env.local (git-ignored) and fill in. Never commit real values. Next.js loads .env.local before .env.

# PostgreSQL connection string. For local development use a Neon DEVELOPMENT branch (never production), with SSL:
# postgresql://<user>:<password>@<dev-branch-host>/<database>?sslmode=require
DATABASE_URL=

# Signs session cookies and derives the OTP hash key. At least 32 random characters, different from production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Which OTP provider to use. Choose ONE:
#   mock    development only: no email is sent; the code is shown in the UI and printed in the dev server terminal
#   resend  real email through Resend (needs RESEND_API_KEY)
# Unset or any other value disables OTP (501). mock is refused when NODE_ENV=production.
OTP_PROVIDER=mock

# Legacy switch, only used when OTP_PROVIDER is unset (mock only, never in production). Prefer OTP_PROVIDER.
MOCK_OTP=

# Needed when OTP_PROVIDER=resend, and for password reset in production
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. RoboValley <no-reply@mail.techytree.in>. The sign-up code email falls back to the Resend
# shared dev sender when this is empty; password reset never does (in production it stays OFF instead). See docs/PASSWORD-RESET-SETUP.md
RESEND_FROM_EMAIL=
# The app's own address, used for password reset links (https in production, no trailing slash), e.g. https://app.techytree.in
# Required for password reset in production; in development the request's own address is used when this is empty.
APP_URL=
ADMIN1_EMAIL=admin1@example.com
ADMIN1_PASSWORD=
ADMIN2_EMAIL=admin2@example.com
ADMIN2_PASSWORD=


# Browser origins allowed to call the API with cookies (comma-separated, no trailing slash). Read at runtime; nothing is hard-coded.
# e.g. https://techytree.in,https://www.techytree.in  plus your local WordPress origin for development.
ALLOWED_ORIGINS=

# The single administrator used by scripts/seed-admin.mjs. Every other account is demoted to a normal user.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local Docker Postgres only (docker compose --env-file .env.local up -d)
LOCAL_PG_PASSWORD=

# Local WordPress in Docker (docker-compose.wordpress.yml). Any strong random values.
WP_DB_PASSWORD=
WP_DB_ROOT_PASSWORD=
WP_ADMIN_PASSWORD=

# Where everyone (admins too) lands after signing in: the normal website. Defaults to https://techytree.in/
# Local WordPress: http://localhost:8080/
SITE_URL=

# --- RoboValley Projects (members-only project details come from the WordPress plugin through a signed server-to-server bridge) ---
# Address of the WordPress site as THIS SERVER reaches it, no trailing slash. e.g. https://techytree.in  (local WordPress: http://localhost:8080)
RVP_BRIDGE_URL=
# Must equal the RVP_BRIDGE_SECRET constant in WordPress's wp-config.php. At least 32 random characters; different per environment. Never commit a real value.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RVP_BRIDGE_SECRET=
# Path of the Projects page on the website. Only this page (optionally with ?project=<number>) is accepted as a "returnTo" after sign-in / sign-up. Default /projects/
PROJECTS_RETURN_PATH=
