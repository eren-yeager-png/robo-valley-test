# Copy to .env.local (git-ignored) and fill in. Never commit real values. Next.js loads .env.local before .env.

# PostgreSQL connection string. For local development use a Neon DEVELOPMENT branch (never production), with SSL:
# postgresql://<user>:<password>@<dev-branch-host>/<database>?sslmode=require
DATABASE_URL=

# Signs session cookies and derives the OTP hash key. At least 32 random characters, different from production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Which OTP provider to use. Choose ONE:
#   mock    development only: no email is sent; the code is shown in the UI and printed in the dev server terminal
#   resend  real email through Resend (needs RESEND_API_KEY)
# Unset or any other value disables OTP (501). mock is refused when NODE_ENV=production.
OTP_PROVIDER=mock

# Legacy switch, only used when OTP_PROVIDER is unset (mock only, never in production). Prefer OTP_PROVIDER.
MOCK_OTP=

# Only needed when OTP_PROVIDER=resend
RESEND_API_KEY=
# Optional sender; defaults to the Resend shared dev sender
RESEND_FROM_EMAIL=
ADMIN1_EMAIL=admin1@example.com
ADMIN1_PASSWORD=
ADMIN2_EMAIL=admin2@example.com
ADMIN2_PASSWORD=
ADMIN3_EMAIL=admin3@example.com
ADMIN3_PASSWORD=
