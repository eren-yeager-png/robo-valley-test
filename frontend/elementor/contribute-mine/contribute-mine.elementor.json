          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<!-- rv-contribute widget 03 your contributions -->\n<section class=\"rv-my\" id=\"rv-my\" data-contribute-url=\"/contribute-now/\" aria-labelledby=\"rv-my-title\">\n\t<div class=\"rv-my-head\">\n\t\t<h1 class=\"rv-my-title\" id=\"rv-my-title\">Your contributions</h1>\n\t\t<span class=\"rv-my-badge\" id=\"rv-my-badge\" hidden>Contributor</span>\n\t</div>\n\t<p class=\"rv-my-lead\">Everything you have started or sent, and where it stands. Only you can see this page.</p>\n\t<div class=\"rv-my-state\" id=\"rv-my-state\" role=\"status\"><p class=\"rv-my-msg\">Loading your contributions…</p></div>\n\t<div class=\"rv-my-body\" id=\"rv-my-body\" hidden></div>\n</section>\n<style>\n.rv-my{--my-brand:#17694f;--my-dark:#123f33;--my-fg:#15302a;--my-muted:#56675f;--my-line:#d6dfd9;--my-tint:#e3ede7;--my-amber-bg:#fbefd9;--my-amber-ink:#5a3b06;max-width:900px;margin:0 auto;padding:8px 20px 40px;font-family:'Mulish',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:var(--my-fg)}\n.rv-my *{box-sizing:border-box}\n.rv-my [hidden]{display:none}\n.rv-my-head{display:flex;flex-wrap:wrap;align-items:center;gap:12px}\n.rv-my-title{margin:6px 0;font-family:'Bricolage Grotesque','Mulish',system-ui,sans-serif;font-weight:800;font-size:clamp(28px,4.2vw,44px);line-height:1.1;color:var(--my-dark)}\n.rv-my-badge{display:inline-flex;align-items:center;min-height:32px;padding:0 14px;font-weight:800;font-size:14px;letter-spacing:.03em;color:#fff;background:var(--my-brand);border-radius:999px}\n.rv-my-lead{margin:0 0 18px;font-size:17px;color:var(--my-muted)}\n.rv-my-state{padding:20px;background:var(--my-tint);border-radius:18px}\n.rv-my-state--error{color:var(--my-amber-ink);background:var(--my-amber-bg)}\n.rv-my-msg{margin:0 0 10px}\n.rv-my-counts{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 18px;padding:0;list-style:none}\n.rv-my-counts li{padding:6px 12px;font-size:14px;font-weight:700;background:var(--my-tint);border-radius:999px}\n.rv-my-group{margin:0 0 22px}\n.rv-my-gh{margin:0 0 10px;font-family:'Bricolage Grotesque','Mulish',system-ui,sans-serif;font-weight:800;font-size:22px;color:var(--my-dark)}\n.rv-my-list{display:grid;gap:12px;margin:0;padding:0;list-style:none}\n.rv-my-item{padding:16px 18px;background:#fff;border:1.5px solid var(--my-line);border-radius:16px}\n.rv-my-it{margin:0 0 4px;font-weight:800;font-size:18px;overflow-wrap:anywhere}\n.rv-my-meta{margin:0;font-size:14px;color:var(--my-muted)}\n.rv-my-note{margin:10px 0 0;padding:10px 14px;font-size:15px;color:var(--my-amber-ink);background:var(--my-amber-bg);border:1px solid #f0cf96;border-radius:12px;overflow-wrap:anywhere}\n.rv-my-note strong{display:block;margin-bottom:2px}\n.rv-my-kind{margin:10px 0 0;font-size:15px}\n.rv-my-actions{margin-top:12px}\n.rv-my-btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 18px;font:inherit;font-weight:800;color:var(--my-brand);background:#fff;border:1.5px solid #b9cfc4;border-radius:12px;text-decoration:none;cursor:pointer}\n.rv-my-btn:hover{background:var(--my-tint);border-color:var(--my-brand)}\n.rv-my-btn--primary{color:#fff;background:var(--my-brand);border-color:var(--my-brand)}\n.rv-my-btn--primary:hover{background:var(--my-dark);border-color:var(--my-dark);color:#fff}\n.rv-my :focus-visible{outline:3px solid #9AD3B5;outline-offset:2px}\n@media (max-width:640px){.rv-my{padding:8px 14px 40px}.rv-my-btn{width:100%}}\n</style>\n<script>\n( function () {\n\tvar root = document.getElementById( 'rv-my' );\n\tif ( ! root || root.getAttribute( 'data-ready' ) ) {\n\t\treturn;\n\t}\n\troot.setAttribute( 'data-ready', '1' );\n\tvar api = ( window.RoboValleyApi && window.RoboValleyApi.base ) || '';\n\tvar contributeUrl = root.getAttribute( 'data-contribute-url' ) || '/contribute-now/';\n\tvar state = document.getElementById( 'rv-my-state' ), body = document.getElementById( 'rv-my-body' ), badge = document.getElementById( 'rv-my-badge' );\n\tvar ORDER = [ 'draft', 'changes_requested', 'pending_review', 'published', 'unpublished', 'rejected' ];\n\tvar GROUP_TITLE = { draft: 'Drafts', changes_requested: 'Changes requested', pending_review: 'Pending review', published: 'Published', unpublished: 'Taken down', rejected: 'Not accepted' };\n\tvar EDIT_LABEL = { draft: 'Continue editing', changes_requested: 'Make the changes', published: 'Edit (goes back for review)', unpublished: 'Edit and send again', pending_review: 'Edit' };\n\n\tfunction make( tag, cls, text ) {\n\t\tvar n = document.createElement( tag );\n\t\tif ( cls ) {\n\t\t\tn.className = cls;\n\t\t}\n\t\tif ( text != null ) {\n\t\t\tn.textContent = text;\n\t\t}\n\t\treturn n;\n\t}\n\tfunction clear( n ) {\n\t\twhile ( n.firstChild ) {\n\t\t\tn.removeChild( n.firstChild );\n\t\t}\n\t}\n\tfunction link( label, href, primary ) {\n\t\tvar a = make( 'a', 'rv-my-btn' + ( primary ? ' rv-my-btn--primary' : '' ), label );\n\t\ta.href = href;\n\t\treturn a;\n\t}\n\tfunction showState( kind, msg, retry ) {\n\t\tclear( state );\n\t\tstate.className = 'rv-my-state' + ( kind === 'error' ? ' rv-my-state--error' : '' );\n\t\tstate.appendChild( make( 'p', 'rv-my-msg', msg ) );\n\t\tif ( retry ) {\n\t\t\tvar b = make( 'button', 'rv-my-btn', 'Try again' );\n\t\t\tb.type = 'button';\n\t\t\tb.addEventListener( 'click', load );\n\t\t\tstate.appendChild( b );\n\t\t}\n\t\tstate.hidden = false;\n\t\tbody.hidden = true;\n\t\treturn state;\n\t}\n\tfunction when( iso ) {\n\t\tvar t = new Date( iso );\n\t\treturn isNaN( t.getTime() ) ? '' : t.toLocaleDateString( 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' } );\n\t}\n\tfunction itemCard( it ) {\n\t\tvar li = make( 'li', 'rv-my-item' );\n\t\tli.appendChild( make( 'p', 'rv-my-it', it.title ) );\n\t\tvar names = ( it.sectors || [] ).map( function ( s ) { return s.name; } ).join( ', ' );\n\t\tli.appendChild( make( 'p', 'rv-my-meta', [ it.typeLabel, names, 'Updated ' + when( it.updatedAt ) ].filter( Boolean ).join( ' · ' ) ) );\n\t\tif ( it.status === 'rejected' ) {\n\t\t\tli.appendChild( make( 'p', 'rv-my-kind', 'Thank you for taking the time to share this. It was not accepted this time. You are welcome to start a new contribution.' ) );\n\t\t} else if ( it.status === 'unpublished' ) {\n\t\t\tli.appendChild( make( 'p', 'rv-my-kind', 'This was taken off the site. You can change it and send it again.' ) );\n\t\t} else if ( it.status === 'pending_review' ) {\n\t\t\tli.appendChild( make( 'p', 'rv-my-kind', 'A moderator will read this soon.' ) );\n\t\t}\n\t\tif ( it.note ) {\n\t\t\tvar n = make( 'div', 'rv-my-note' );\n\t\t\tn.appendChild( make( 'strong', null, 'Note from the moderator' ) );\n\t\t\tn.appendChild( document.createTextNode( it.note ) );\n\t\t\tli.appendChild( n );\n\t\t}\n\t\tif ( it.canEdit ) {\n\t\t\tvar act = make( 'div', 'rv-my-actions' );\n\t\t\tvar a = link( EDIT_LABEL[ it.status ] || 'Edit', contributeUrl + ( contributeUrl.indexOf( '?' ) < 0 ? '?' : '&' ) + 'edit=' + encodeURIComponent( it.id ) );\n\t\t\ta.setAttribute( 'aria-label', ( EDIT_LABEL[ it.status ] || 'Edit' ) + ': ' + it.title );\n\t\t\tact.appendChild( a );\n\t\t\tli.appendChild( act );\n\t\t}\n\t\treturn li;\n\t}\n\tfunction render( data ) {\n\t\tclear( body );\n\t\tbadge.hidden = ! data.contributor;\n\t\tif ( ! data.items.length ) {\n\t\t\tshowState( 'info', 'You have not started a contribution yet. Share what you know and it will appear here.', false ).appendChild( link( 'Contribute now', contributeUrl, true ) );\n\t\t\treturn;\n\t\t}\n\t\tvar counts = make( 'ul', 'rv-my-counts' );\n\t\tcounts.setAttribute( 'aria-label', 'How many contributions in each state' );\n\t\tORDER.forEach( function ( s ) {\n\t\t\tvar n = data.counts && data.counts[ s ];\n\t\t\tif ( n ) {\n\t\t\t\tcounts.appendChild( make( 'li', null, GROUP_TITLE[ s ] + ': ' + n ) );\n\t\t\t}\n\t\t} );\n\t\tbody.appendChild( counts );\n\t\tORDER.forEach( function ( s ) {\n\t\t\tvar items = data.items.filter( function ( it ) { return it.status === s; } );\n\t\t\tif ( ! items.length ) {\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tvar g = make( 'section', 'rv-my-group' );\n\t\t\tg.appendChild( make( 'h2', 'rv-my-gh', GROUP_TITLE[ s ] + ' (' + items.length + ')' ) );\n\t\t\tvar ul = make( 'ul', 'rv-my-list' );\n\t\t\titems.forEach( function ( it ) {\n\t\t\t\tul.appendChild( itemCard( it ) );\n\t\t\t} );\n\t\t\tg.appendChild( ul );\n\t\t\tbody.appendChild( g );\n\t\t} );\n\t\tvar more = make( 'div', 'rv-my-actions' );\n\t\tmore.appendChild( link( 'Pick another sector and contribute again', contributeUrl, true ) );\n\t\tbody.appendChild( more );\n\t\tstate.hidden = true;\n\t\tbody.hidden = false;\n\t}\n\tfunction friendly( r, b ) {\n\t\tif ( r.status === 429 ) {\n\t\t\treturn 'Lots of people are visiting right now. Please try again in ' + ( b && b.retryAfter ? b.retryAfter : 30 ) + ' seconds.';\n\t\t}\n\t\tif ( r.status === 503 ) {\n\t\t\treturn 'Contributions are not open yet. Please check back soon.';\n\t\t}\n\t\treturn 'Your contributions could not be loaded. Please try again.';\n\t}\n\tfunction load() {\n\t\tif ( ! api || ! window.fetch ) {\n\t\t\tshowState( 'error', 'This page is not connected to RoboValley yet. Please try again later.', false );\n\t\t\treturn;\n\t\t}\n\t\tshowState( 'info', 'Loading your contributions…', false );\n\t\tfetch( api + '/api/auth/me', { credentials: 'include', cache: 'no-store' } ).then( function ( r ) { return r.json(); } ).then( function ( me ) {\n\t\t\tif ( ! me || ! me.role ) {\n\t\t\t\tvar back = location.origin + location.pathname;\n\t\t\t\tvar s = showState( 'info', 'Please sign in to see your contributions.', false );\n\t\t\t\ts.appendChild( link( 'Sign in', api + '/login?returnTo=' + encodeURIComponent( back ), true ) );\n\t\t\t\treturn null;\n\t\t\t}\n\t\t\treturn fetch( api + '/api/contributions/mine', { credentials: 'include', cache: 'no-store' } ).then( function ( r ) {\n\t\t\t\treturn r.json().catch( function () { return null; } ).then( function ( b ) {\n\t\t\t\t\tif ( r.status === 401 ) {\n\t\t\t\t\t\tvar s2 = showState( 'info', 'Please sign in to see your contributions.', false );\n\t\t\t\t\t\ts2.appendChild( link( 'Sign in', api + '/login?returnTo=' + encodeURIComponent( location.origin + location.pathname ), true ) );\n\t\t\t\t\t\treturn null;\n\t\t\t\t\t}\n\t\t\t\t\tif ( ! r.ok || ! b || b.success !== true || ! Array.isArray( b.items ) ) {\n\t\t\t\t\t\tshowState( 'error', friendly( r, b ), r.status !== 503 );\n\t\t\t\t\t\treturn null;\n\t\t\t\t\t}\n\t\t\t\t\trender( b );\n\t\t\t\t\treturn null;\n\t\t\t\t} );\n\t\t\t} );\n\t\t} ).catch( function () {\n\t\t\tshowState( 'error', 'Your contributions could not be loaded. Please check your connection and try again.', true );\n\t\t} );\n\t}\n\tload();\n}() );\n</script>\n"
          },
          "elements": []
        }
      ]
    }
  ]
}
