        {
          "id": "rvw0a01w",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<!-- rv-contribute widget 01 hub -->\n<div class=\"rv-hub\" id=\"rv-hub\" aria-live=\"polite\">\n\t<h1 class=\"rv-hub-title\">Contribute to RoboValley</h1>\n\t<p class=\"rv-hub-lead\">Pick one or more sectors, then share what you know. Everything you send is reviewed before it is published.</p>\n\t<div class=\"rv-hub-state\" id=\"rv-hub-state\"><p class=\"rv-hub-msg\">Loading the sectors…</p></div>\n\t<div class=\"rv-hub-grid\" id=\"rv-hub-grid\" role=\"group\" aria-label=\"Sectors\" hidden></div>\n\t<div class=\"rv-hub-actions\" id=\"rv-hub-actions\" hidden>\n\t\t<button type=\"button\" class=\"rv-hub-btn rv-hub-btn--primary\" id=\"rv-hub-go\" disabled>Pick a sector to begin</button>\n\t\t<p class=\"rv-hub-note\" id=\"rv-hub-note\" role=\"status\" hidden></p>\n\t</div>\n</div>\n<style>\n.rv-hub{--hub-brand:#17694f;--hub-dark:#123f33;--hub-fg:#15302a;--hub-muted:#56675f;--hub-line:#d6dfd9;--hub-tint:#e3ede7;--hub-amber-bg:#fbefd9;--hub-amber-ink:#5a3b06;max-width:1200px;margin:0 auto;padding:8px 20px 40px;font-family:'Mulish',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:var(--hub-fg)}\n.rv-hub *{box-sizing:border-box}\n.rv-hub-title{margin:6px 0;font-family:'Bricolage Grotesque','Mulish',system-ui,sans-serif;font-weight:800;font-size:clamp(28px,4.2vw,44px);line-height:1.1;color:var(--hub-dark)}\n.rv-hub-lead{margin:0 0 18px;max-width:760px;font-size:17px;color:var(--hub-muted)}\n.rv-hub-grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(280px,1fr))}\n.rv-hub-grid[hidden],.rv-hub-actions[hidden],.rv-hub-state[hidden],.rv-hub-note[hidden]{display:none}\n.rv-hub-card{padding:20px;background:#fff;border:1.5px solid var(--hub-line);border-radius:18px;box-shadow:0 1px 2px rgba(21,48,42,.05)}\n.rv-hub-card.is-picked{border-color:var(--hub-brand);box-shadow:0 0 0 3px rgba(23,105,79,.18)}\n.rv-hub-name{margin:0 0 6px;font-family:'Bricolage Grotesque','Mulish',system-ui,sans-serif;font-weight:800;font-size:22px;color:var(--hub-dark)}\n.rv-hub-count{margin:0;font-family:'Bricolage Grotesque','Mulish',system-ui,sans-serif;font-weight:800;font-size:32px;line-height:1.1;color:var(--hub-brand)}\n.rv-hub-count--empty{font-size:22px}\n.rv-hub-sub{margin:2px 0 0;font-size:14px;color:var(--hub-muted)}\n.rv-hub-pick{display:inline-flex;align-items:center;gap:10px;min-height:44px;margin-top:12px;font-weight:700;cursor:pointer}\n.rv-hub-pick input{width:22px;height:22px;accent-color:var(--hub-brand)}\n.rv-hub-actions{margin-top:18px}\n.rv-hub-btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 18px;font:inherit;font-weight:800;color:var(--hub-brand);background:#fff;border:1.5px solid #b9cfc4;border-radius:12px;cursor:pointer}\n.rv-hub-btn:hover{background:var(--hub-tint);border-color:var(--hub-brand)}\n.rv-hub-btn--primary{color:#fff;background:var(--hub-brand);border-color:var(--hub-brand)}\n.rv-hub-btn--primary:hover{background:var(--hub-dark);border-color:var(--hub-dark)}\n.rv-hub-btn[disabled]{opacity:.5;cursor:not-allowed}\n.rv-hub :focus-visible{outline:3px solid #9AD3B5;outline-offset:2px}\n.rv-hub-note{margin:12px 0 0;padding:12px 16px;font-size:15px;color:var(--hub-amber-ink);background:var(--hub-amber-bg);border:1px solid #f0cf96;border-radius:14px}\n.rv-hub-state{padding:20px;background:var(--hub-tint);border-radius:18px}\n.rv-hub-state--error{color:var(--hub-amber-ink);background:var(--hub-amber-bg)}\n.rv-hub-msg{margin:0 0 8px}\n@media (max-width:640px){.rv-hub{padding:8px 14px 40px}}\n</style>\n<script>\n( function () {\n\tvar root = document.getElementById( 'rv-hub' );\n\tif ( ! root || root.getAttribute( 'data-ready' ) ) {\n\t\treturn;\n\t}\n\troot.setAttribute( 'data-ready', '1' );\n\tvar api = ( window.RoboValleyApi && window.RoboValleyApi.base ) || '';\n\tvar state = document.getElementById( 'rv-hub-state' ), grid = document.getElementById( 'rv-hub-grid' ), actions = document.getElementById( 'rv-hub-actions' );\n\tvar go = document.getElementById( 'rv-hub-go' ), note = document.getElementById( 'rv-hub-note' );\n\tvar picked = [], sectors = [];\n\n\tfunction make( tag, cls, text ) {\n\t\tvar n = document.createElement( tag );\n\t\tif ( cls ) {\n\t\t\tn.className = cls;\n\t\t}\n\t\tif ( text != null ) {\n\t\t\tn.textContent = text;\n\t\t}\n\t\treturn n;\n\t}\n\tfunction clear( n ) {\n\t\twhile ( n.firstChild ) {\n\t\t\tn.removeChild( n.firstChild );\n\t\t}\n\t}\n\tfunction showState( kind, msg, retry ) {\n\t\tclear( state );\n\t\tstate.className = 'rv-hub-state' + ( kind === 'error' ? ' rv-hub-state--error' : '' );\n\t\tstate.appendChild( make( 'p', 'rv-hub-msg', msg ) );\n\t\tif ( retry ) {\n\t\t\tvar b = make( 'button', 'rv-hub-btn', 'Try again' );\n\t\t\tb.type = 'button';\n\t\t\tb.addEventListener( 'click', load );\n\t\t\tstate.appendChild( b );\n\t\t}\n\t\tstate.hidden = false;\n\t\tgrid.hidden = true;\n\t\tactions.hidden = true;\n\t}\n\tfunction plural( n, one, many ) {\n\t\treturn n + ' ' + ( n === 1 ? one : many );\n\t}\n\tfunction paintButton() {\n\t\tgo.disabled = picked.length === 0;\n\t\tgo.textContent = picked.length ? 'Contribute in ' + plural( picked.length, 'sector', 'sectors' ) : 'Pick a sector to begin';\n\t}\n\tfunction render() {\n\t\tclear( grid );\n\t\tsectors.forEach( function ( s ) {\n\t\t\tvar on = picked.indexOf( s.slug ) >= 0;\n\t\t\tvar card = make( 'div', 'rv-hub-card' + ( on ? ' is-picked' : '' ) );\n\t\t\tcard.appendChild( make( 'h2', 'rv-hub-name', s.name ) );\n\t\t\tif ( s.empty ) {\n\t\t\t\tcard.appendChild( make( 'p', 'rv-hub-count rv-hub-count--empty', 'Be the first to contribute' ) );\n\t\t\t} else {\n\t\t\t\tcard.appendChild( make( 'p', 'rv-hub-count', String( s.contributions ) ) );\n\t\t\t\tcard.appendChild( make( 'p', 'rv-hub-sub', s.contributions === 1 ? 'published contribution' : 'published contributions' ) );\n\t\t\t\tif ( s.contributors !== null && s.contributors !== undefined ) {\n\t\t\t\t\tcard.appendChild( make( 'p', 'rv-hub-sub', plural( s.contributors, 'contributor', 'contributors' ) ) );\n\t\t\t\t}\n\t\t\t}\n\t\t\tvar label = make( 'label', 'rv-hub-pick' );\n\t\t\tvar box = document.createElement( 'input' );\n\t\t\tbox.type = 'checkbox';\n\t\t\tbox.checked = on;\n\t\t\tbox.setAttribute( 'aria-label', 'Pick ' + s.name );\n\t\t\tbox.addEventListener( 'change', function () {\n\t\t\t\tvar i = picked.indexOf( s.slug );\n\t\t\t\tif ( box.checked && i < 0 ) {\n\t\t\t\t\tpicked.push( s.slug );\n\t\t\t\t} else if ( ! box.checked && i >= 0 ) {\n\t\t\t\t\tpicked.splice( i, 1 );\n\t\t\t\t}\n\t\t\t\tnote.hidden = true;\n\t\t\t\tcard.className = 'rv-hub-card' + ( box.checked ? ' is-picked' : '' );\n\t\t\t\tpaintButton();\n\t\t\t} );\n\t\t\tlabel.appendChild( box );\n\t\t\tlabel.appendChild( document.createTextNode( 'Pick this sector' ) );\n\t\t\tcard.appendChild( label );\n\t\t\tgrid.appendChild( card );\n\t\t} );\n\t\tstate.hidden = true;\n\t\tgrid.hidden = false;\n\t\tactions.hidden = false;\n\t\tpaintButton();\n\t}\n\t/** The hub only chooses sectors. The form that follows listens for this event; if nothing is listening yet, say so politely. */\n\tgo.addEventListener( 'click', function () {\n\t\tif ( ! picked.length ) {\n\t\t\treturn;\n\t\t}\n\t\tvar ev = new CustomEvent( 'rv-contribute-pick', { detail: { sectors: picked.slice() }, cancelable: true } );\n\t\tdocument.dispatchEvent( ev );\n\t\tif ( ! ev.defaultPrevented ) {\n\t\t\tnote.textContent = 'Sharing opens soon: the form is not on this page yet. Your sectors are noted.';\n\t\t\tnote.hidden = false;\n\t\t}\n\t} );\n\tfunction load() {\n\t\tif ( ! api || ! window.fetch ) {\n\t\t\tshowState( 'error', 'This page is not connected to RoboValley yet. Please try again later.', false );\n\t\t\treturn;\n\t\t}\n\t\tshowState( 'info', 'Loading the sectors…', false );\n\t\tfetch( api + '/api/contributions/sectors', { cache: 'no-store' } ).then( function ( r ) {\n\t\t\treturn r.json().catch( function () { return null; } ).then( function ( body ) {\n\t\t\t\tif ( r.status === 429 ) {\n\t\t\t\t\tvar n = body && body.retryAfter ? body.retryAfter : 30;\n\t\t\t\t\tthrow { friendly: 'Lots of people are visiting right now. Please try again in ' + n + ' seconds.' };\n\t\t\t\t}\n\t\t\t\tif ( ! r.ok || ! body || body.success !== true || ! Array.isArray( body.sectors ) ) {\n\t\t\t\t\tthrow { friendly: 'The sectors are not available right now. Please try again.' };\n\t\t\t\t}\n\t\t\t\treturn body.sectors;\n\t\t\t} );\n\t\t} ).then( function ( list ) {\n\t\t\tsectors = list.filter( function ( s ) { return s && typeof s.slug === 'string' && typeof s.name === 'string'; } );\n\t\t\tpicked = picked.filter( function ( p ) { return sectors.some( function ( s ) { return s.slug === p; } ); } );\n\t\t\tif ( ! sectors.length ) {\n\t\t\t\tshowState( 'info', 'There are no sectors to show yet. Please check back soon.', false );\n\t\t\t\treturn;\n\t\t\t}\n\t\t\trender();\n\t\t} ).catch( function ( e ) {\n\t\t\tshowState( 'error', e && e.friendly ? e.friendly : 'The sectors could not be loaded. Please check your connection and try again.', true );\n\t\t} );\n\t}\n\tload();\n}() );\n</script>\n"
          },
          "elements": []
        }
      ]
    },
    {
      "id": "rvw0a02",
      "elType": "container",
      "settings": {
        "_title": "Contribute form",
        "content_width": "full",
        "padding": {
          "unit": "px",
