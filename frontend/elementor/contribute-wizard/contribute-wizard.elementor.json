rv-wz-row' );\n\t\trow.appendChild( a );\n\t\tvar j = make( 'a', 'rv-wz-link', 'Create an account' );\n\t\tj.href = api + '/join?returnTo=' + encodeURIComponent( back );\n\t\trow.appendChild( j );\n\t\tbodyEl.appendChild( row );\n\t}\n\tfunction stepScope() {\n\t\theading( 'Which sectors is this about?', 'Pick one or more. You can change this later in the form.' );\n\t\tvar fs = make( 'fieldset', 'rv-wz-opts' ), lg = make( 'legend', 'rv-wz-hint', 'Sectors' );\n\t\tlg.className = 'rv-wz-hint';\n\t\tfs.appendChild( lg );\n\t\tvar holder = make( 'div', 'rv-wz-field' );\n\t\tholder.setAttribute( 'data-field', 'sectors' );\n\t\tholder.tabIndex = -1;\n\t\tallSectors.forEach( function ( s ) {\n\t\t\tvar on = d.sectors.indexOf( s.slug ) >= 0;\n\t\t\tvar lab = make( 'label', 'rv-wz-opt' + ( on ? ' is-on' : '' ) );\n\t\t\tvar box = document.createElement( 'input' );\n\t\t\tbox.type = 'checkbox';\n\t\t\tbox.checked = on;\n\t\t\tbox.value = s.slug;\n\t\t\tbox.addEventListener( 'change', function () {\n\t\t\t\tvar i = d.sectors.indexOf( s.slug );\n\t\t\t\tif ( box.checked && i < 0 ) {\n\t\t\t\t\td.sectors.push( s.slug );\n\t\t\t\t} else if ( ! box.checked && i >= 0 ) {\n\t\t\t\t\td.sectors.splice( i, 1 );\n\t\t\t\t}\n\t\t\t\tlab.className = 'rv-wz-opt' + ( box.checked ? ' is-on' : '' );\n\t\t\t} );\n\t\t\tlab.appendChild( box );\n\t\t\tlab.appendChild( document.createTextNode( s.name ) );\n\t\t\tfs.appendChild( lab );\n\t\t} );\n\t\tbodyEl.appendChild( fs );\n\t\tvar err = make( 'span', 'rv-wz-err' );\n\t\terr.setAttribute( 'data-err', 'sectors' );\n\t\tbodyEl.appendChild( err );\n\t\tnav( null, 'Continue', function () {\n\t\t\tif ( ! d.sectors.length ) {\n\t\t\t\tshowErrors( { sectors: 'Choose at least one sector.' } );\n\t\t\t\tfs.querySelector( 'input' ).focus();\n\t\t\t\treturn;\n\t\t\t}\n\t\t\trender( 2 );\n\t\t} );\n\t}\n\tfunction stepType() {\n\t\theading( 'What do you want to contribute?', 'Choose the one that fits best.' );\n\t\tvar wrap = make( 'div' );\n\t\twrap.setA