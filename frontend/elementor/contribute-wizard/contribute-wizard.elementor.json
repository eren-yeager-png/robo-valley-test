unction add( key, label, hint, opts ) {\n\t\t\topts = opts || {};\n\t\t\topts.value = d[ key ];\n\t\t\topts.onInput = function ( v ) { d[ key ] = v; };\n\t\t\tf = field( key, label, hint, opts );\n\t\t\tbodyEl.appendChild( f );\n\t\t\tif ( opts.area && opts.max ) {\n\t\t\t\tf.insertBefore( counter( f.querySelector( 'textarea' ), opts.max ), f.querySelector( '.rv-wz-err' ) );\n\t\t\t}\n\t\t}\n\t\tadd( 'title', 'Title', 'A short headline, 5 to 150 characters.', { max: 150, required: true } );\n\t\tadd( 'description', 'Details', 'What is the situation? At least 10 characters.', { area: true, max: 2000, required: true } );\n\t\tadd( 'howNow', 'How it is done now (optional)', null, { area: true, max: 800 } );\n\t\tadd( 'affected', 'Who is affected (optional)', null, { area: true, max: 800 } );\n\t\tadd( 'timeCost', 'Time or cost (optional)', 'For example hours a day or rupees a month.', { area: true, max: 800 } );\n\t\tadd( 'improvement', 'What should improve (optional)', null, { area: true, max: 800 } );\n\t\tadd( 'role', 'Your role (optional)', 'For example farmer, teacher, nurse.', { max: 80 } );\n\t\tadd( 'district', 'Your district (optional)', null, { max: 80 } );\n\t\tadd( 'robotType', 'Robot type (optional)', 'Lowercase words with dashes, like milking-robot.', { max: 60 } );\n\n\t\t/* one photo, with a description for people who cannot see it */\n\t\tvar pw = make( 'div', 'rv-wz-box' );\n\t\tpw.appendChild( make( 'strong', null, 'One photo (optional)' ) );\n\t\tpw.appendChild( make( 'span', 'rv-wz-hint', 'JPG or PNG, up to 4 MB. Hidden details such as the place the photo was taken are removed.' ) );\n\t\tvar file = document.createElement( 'input' );\n\t\tfile.type = 'file';\n\t\tfile.id = 'rv-wz-f-photo';\n\t\tfile.accept = 'image/jpeg,image/png';\n\t\tfile.className = 'rv-wz-in';\n\t\tfile.setAttribute( 'data-field', 'photo' );\n\t\tfile.setAttribute( 'aria-describedby', 'rv-wz-f-photo-err' );\n\t\tvar fl = make( 'label', 'rv-wz-label', 'Photo' );\n\t\tfl.setAttr