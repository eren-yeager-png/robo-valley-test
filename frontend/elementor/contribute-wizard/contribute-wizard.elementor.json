      "elements": [
        {
          "id": "rvw0a02w",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<!-- rv-contribute widget 02 wizard -->\n<section class=\"rv-wz\" id=\"rv-wz\" aria-labelledby=\"rv-wz-steps\" hidden>\n\t<p class=\"rv-wz-steps\" id=\"rv-wz-steps\"></p>\n\t<div class=\"rv-wz-errors\" id=\"rv-wz-errors\" role=\"alert\" aria-live=\"assertive\" hidden></div>\n\t<div class=\"rv-wz-body\" id=\"rv-wz-body\"></div>\n\t<p class=\"rv-wz-status\" id=\"rv-wz-status\" role=\"status\" aria-live=\"polite\"></p>\n</section>\n<style>\n.rv-wz{--wz-brand:#17694f;--wz-dark:#123f33;--wz-fg:#15302a;--wz-muted:#56675f;--wz-line:#d6dfd9;--wz-tint:#e3ede7;--wz-amber-bg:#fbefd9;--wz-amber-ink:#5a3b06;--wz-err:#8a1f11;--wz-err-bg:#fdecea;max-width:820px;margin:8px auto 0;padding:22px 20px 40px;font-family:'Mulish',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:var(--wz-fg);background:#fff;border:1.5px solid var(--wz-line);border-radius:20px}\n.rv-wz *{box-sizing:border-box}\n.rv-wz[hidden],.rv-wz-errors[hidden]{display:none}\n.rv-wz-steps{margin:0 0 6px;font-size:14px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--wz-brand)}\n.rv-wz-h{margin:0 0 6px;font-family:'Bricolage Grotesque','Mulish',system-ui,sans-serif;font-weight:800;font-size:clamp(24px,3.4vw,32px);line-height:1.15;color:var(--wz-dark)}\n.rv-wz-h:focus{outline:none}\n.rv-wz-lead{margin:0 0 16px;color:var(--wz-muted);font-size:16px}\n.rv-wz-errors{margin:10px 0 14px;padding:12px 16px;color:var(--wz-err);background:var(--wz-err-bg);border:1.5px solid #e8b4ad;border-radius:14px;font-size:15px}\n.rv-wz-errors ul{margin:6px 0 0;padding-left:20px}\n.rv-wz-field{display:block;margin:0 0 16px;border:0;padding:0}\n.rv-wz-label{display:block;margin:0 0 6px;font-weight:800;font-size:16px}\n.rv-wz-hint{display:block;margin:0 0 6px;font-size:14px;color:var(--wz-muted)}\n.rv-wz-in,.rv-wz-ta{display:block;width:100%;min-height:44px;padding:10px 12px;font:inherit;color:var(--wz-fg);background:#fff;border:1.5px solid #b9cfc4;border-radius:12px}\n.rv-wz-ta{min-height:110px;resize:vertical}\n.rv-wz-in[aria-invalid=\"true\"],.rv-wz-ta[aria-invalid=\"true\"]{border-color:var(--wz-err);background:var(--wz-err-bg)}\n.rv-wz-err{display:block;margin:6px 0 0;font-size:14px;font-weight:700;color:var(--wz-err)}\n.rv-wz-err:empty{display:none}\n.rv-wz-count{display:block;margin:4px 0 0;font-size:13px;color:var(--wz-muted);text-align:right}\n.rv-wz-opts{display:grid;gap:10px;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));margin:0;padding:0;border:0}\n.rv-wz-opt{display:flex;align-items:center;gap:10px;min-height:44px;padding:8px 12px;background:#fff;border:1.5px solid var(--wz-line);border-radius:12px;font-weight:700;cursor:pointer}\n.rv-wz-opt:hover{border-color:var(--wz-brand);background:var(--wz-tint)}\n.rv-wz-opt input{flex:none;width:22px;height:22px;accent-color:var(--wz-brand)}\n.rv-wz-opt.is-on{border-color:var(--wz-brand);box-shadow:0 0 0 3px rgba(23,105,79,.18)}\n.rv-wz-group{margin:0 0 14px;padding:0;border:0}\n.rv-wz-group legend{margin:0 0 8px;padding:0;font-size:13px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--wz-muted)}\n.rv-wz-box{margin:0 0 16px;padding:14px 16px;background:var(--wz-tint);border-radius:14px}\n.rv-wz-private{margin:0 0 10px;font-size:15px}\n.rv-wz-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}\n.rv-wz-btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 18px;font:inherit;font-weight:800;color:var(--wz-brand);background:#fff;border:1.5px solid #b9cfc4;border-radius:12px;cursor:pointer}\n.rv-wz-btn:hover{background:var(--wz-tint);border-color:var(--wz-brand)}\n.rv-wz-btn--primary{color:#fff;background:var(--wz-brand);border-color:var(--wz-brand)}\n.rv-wz-btn--primary:hover{background:var(--wz-dark);border-color:var(--wz-dark)}\n.rv-wz-btn[disabled]{opacity:.5;cursor:not-allowed}\n.rv-wz-link{display:inline-flex;align-items:center;min-height:44px}\n.rv-wz :focus-visible{outline:3px solid #9AD3B5;outline-offset:2px}\n.rv-wz-status{min-height:22px;margin:12px 0 0;font-size:15px;color:var(--wz-muted)}\n.rv-wz-note{margin:12px 0;padding:12px 16px;font-size:15px;color:var(--wz-amber-ink);background:var(--wz-amber-bg);border:1px solid #f0cf96;border-radius:14px}\n.rv-wz-sum{margin:0 0 16px;padding:0}\n.rv-wz-sum dt{margin:12px 0 2px;font-size:13px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--wz-muted)}\n.rv-wz-sum dd{margin:0;white-space:pre-wrap;overflow-wrap:anywhere}\n.rv-wz-hp{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}\n@media (max-width:640px){.rv-wz{padding:18px 14px 32px;border-radius:16px}.rv-wz-row{flex-direction:column}.rv-wz-btn{width:100%}.rv-wz-opts{grid-template-columns:1fr}}\n</style>\n<script>\n( function () {\n\tvar root = document.getElementById( 'rv-wz' );\n\tif ( ! root || root.getAttribute( 'data-ready' ) ) {\n\t\treturn;\n\t}\n\troot.setAttribute( 'data-ready', '1' );\n\tvar api = ( window.RoboValleyApi && window.RoboValleyApi.base ) || '';\n\tvar stepsEl = document.getElementById( 'rv-wz-steps' ), errorsEl = document.getElementById( 'rv-wz-errors' );\n\tvar bodyEl = document.getElementById( 'rv-wz-body' ), statusEl = document.getElementById( 'rv-wz-status' );\n\tvar TYPES = [\n\t\t[ 'share', 'Share', [ [ 'problem', 'Report a problem' ], [ 'discovered', 'Share a robot you discovered' ], [ 'experience', 'Share firsthand experience' ], [ 'costs', 'Share costs and economics' ], [ 'resource', 'Share a video or resource' ] ] ],\n\t\t[ 'propose', 'Propose', [ [ 'challenge', 'Propose a project challenge' ], [ 'improve', 'Suggest improvements' ] ] ],\n\t\t[ 'offer', 'Offer', [ [ 'rental', 'Offer rental or shared access' ], [ 'repairs', 'Offer repairs or spare parts' ], [ 'support', 'Offer project support' ], [ 'trial', 'Offer a trial site' ], [ 'learning', 'Share learning opportunities' ], [ 'supplier', 'Add a manufacturer or supplier' ] ] ],\n\t\t[ 'fix', 'Fix', [ [ 'correct', 'Correct existing information' ] ] ]\n\t];\n\tvar STEP_NAMES = [ 'Scope', 'Type', 'Details', 'Preview' ];\n\tvar MAX_PHOTO = 4 * 1024 * 1024;\n\tvar d = { sectors: [], type: '', title: '', description: '', howNow: '', affected: '', timeCost: '', improvement: '', role: '', district: '', robotType: '', photo: null, photoAlt: '', photoSent: false, contactOn: false, contact: { name: '', email: '', phone: '', share: false }, contactSaved: false, id: null };\n\tvar allSectors = [], step = 1, busy = false, signedIn = false;\n\n\tfunction make( tag, cls, text ) {\n\t\tvar n = document.createElement( tag );\n\t\tif ( cls ) {\n\t\t\tn.className = cls;\n\t\t}\n\t\tif ( text != null ) {\n\t\t\tn.textContent = text;\n\t\t}\n\t\treturn n;\n\t}\n\tfunction clear( n ) {\n\t\twhile ( n.firstChild ) {\n\t\t\tn.removeChild( n.firstChild );\n\t\t}\n\t}\n\tfunction btn( label, cls, fn ) {\n\t\tvar b = make( 'button', 'rv-wz-btn' + ( cls ? ' ' + cls : '' ), label );\n\t\tb.type = 'button';\n\t\tb.addEventListener( 'click', fn );\n\t\treturn b;\n\t}\n\tfunction sectorName( slug ) {\n\t\tfor ( var i = 0; i < allSectors.length; i++ ) {\n\t\t\tif ( allSectors[ i ].slug === slug ) {\n\t\t\t\treturn allSectors[ i ].name;\n\t\t\t}\n\t\t}\n\t\treturn slug;\n\t}\n\tfunction typeLabel( id ) {\n\t\tfor ( var g = 0; g < TYPES.length; g++ ) {\n\t\t\tfor ( var i = 0; i < TYPES[ g ][ 2 ].length; i++ ) {\n\t\t\t\tif ( TYPES[ g ][ 2 ][ i ][ 0 ] === id ) {\n\t\t\t\t\treturn TYPES[ g ][ 2 ][ i ][ 1 ];\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn '';\n\t}\n\tfunction setStatus( msg ) {\n\t\tstatusEl.textContent = msg || '';\n\t}\n\n\t/* ---------- errors: a live region plus a message under each field ---------- */\n\tfunction clearErrors() {\n\t\terrorsEl.hidden = true;\n\t\tclear( errorsEl );\n\t\tvar f = bodyEl.querySelectorAll( '[aria-invalid]' ), i;\n\t\tfor ( i = 0; i < f.length; i++ ) {\n\t\t\tf[ i ].removeAttribute( 'aria-invalid' );\n\t\t}\n\t\tvar m = bodyEl.querySelectorAll( '.rv-wz-err' );\n\t\tfor ( i = 0; i < m.length; i++ ) {\n\t\t\tm[ 